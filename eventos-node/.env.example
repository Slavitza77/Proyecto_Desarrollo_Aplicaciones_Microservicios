# Copiar a .env y completar. NUNCA versionar .env ni la clave de servicio.
# Ruta ABSOLUTA al JSON de la cuenta de servicio (guardado fuera del repositorio)
GOOGLE_APPLICATION_CREDENTIALS=/ruta/fuera/del/repo/serviceAccountKey.json
# ID del proyecto en Firebase Console
FIREBASE_PROJECT_ID=TU_PROJECT_ID
# Puerto HTTP del servicio
PORT=3000
# New Relic (region United States)
NEW_RELIC_LICENSE_KEY=TU_LICENSE_KEY
NEW_RELIC_APP_NAME=eventos-node-streaming
# Opcional: emulador local de Firestore (pruebas sin cuenta)
# FIRESTORE_EMULATOR_HOST=localhost:8080
